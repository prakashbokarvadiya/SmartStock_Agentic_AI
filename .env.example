# ============================================================
# SmartStock Agentic AI — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file to Git!
# ============================================================

# ── Gemini AI ─────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ── Supabase PostgreSQL ───────────────────────────────────────
# Option A: full connection URL (recommended)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Option B: individual params (used if DATABASE_URL is not set)
POSTGRES_HOST=aws-0-ap-southeast-1.pooler.supabase.com
POSTGRES_PORT=5432
POSTGRES_USER=postgres.your_project_ref
POSTGRES_PASSWORD=your_db_password
POSTGRES_DATABASE=postgres

# ── Email / Gmail ─────────────────────────────────────────────
ADMIN_EMAIL=admin@yourcompany.com

# ── Low Stock Alert ───────────────────────────────────────────
LOW_STOCK_THRESHOLD=3
STOCK_CHECK_INTERVAL=300
